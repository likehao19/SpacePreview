{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpacePreview",
  "version": "0.10.18",
  "identifier": "com.spacepreview.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "瞬览 · SpacePreview",
        "label": "main",
        "width": 1000,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost 'self' asset: http://asset.localhost blob:; worker-src 'self' blob:; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../public/engines/licenses/": "licenses/"
    },
    "targets": ["nsis"],
    "shortDescription": "瞬览 — 不必打开，看一眼就好",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/likehao19/SpacePreview/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMUVGNjk2NEI3QzQ0QwpSV1JNeExka2FlL3hDdXp5S01rWHR2WnBQcmJWaDYyT2dpdktqbktVdXlzYWJyQXhuRDljUjdJbQo="
    }
  }
}
